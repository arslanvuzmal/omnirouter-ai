# ---------------------------------------------------------------------------
# OmniRouter AI — environment template
# Copy to .env.local for development. NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://omnirouter:omnirouter_local_dev@localhost:5435/omnirouter?schema=public"
# Direct (unpooled) connection used by Prisma Migrate. On Supabase these differ:
# DATABASE_URL uses the pooler on port 6543, DIRECT_URL uses port 5432.
DIRECT_URL="postgresql://omnirouter:omnirouter_local_dev@localhost:5435/omnirouter?schema=public"

# --- Secrets ----------------------------------------------------------------
# Signs and verifies session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-32-plus-random-bytes-base64"
# Encrypts stored provider credentials with AES-256-GCM.
# MUST be exactly 32 bytes, base64-encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-exactly-32-random-bytes-base64"
# Guards internal maintenance endpoints. Generate: openssl rand -base64 32
INTERNAL_API_SECRET="replace-with-32-plus-random-bytes-base64"

# --- Application ------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Demo mode --------------------------------------------------------------
# When true, the deterministic demo provider and demo accounts are available.
# The public portfolio deployment runs with DEMO_MODE=true and no provider keys.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
# Password assigned to seeded demo accounts. Development/demo use only.
DEMO_PASSWORD="OmniDemo!2026"

# --- Optional provider credentials -----------------------------------------
# All optional. With none set, the application remains fully functional
# through the deterministic demo provider.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
# DEEPSEEK_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434"
